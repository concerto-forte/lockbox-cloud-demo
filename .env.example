# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
# 32 bytes Base64. Sinh bằng: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
KMS_MASTER_KEY_B64=replace-with-a-base64-32-byte-key
DEMO_MODE=true
DATABASE_URL=sqlite:///./lockbox.db

